{
  "cli": {
    "version": ">= 15.0.10",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "DATADOG_SITE": "us5.datadoghq.com" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "DATADOG_SITE": "us5.datadoghq.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "DATADOG_SITE": "us5.datadoghq.com" }
    }
  },
  "submit": {
    "production": {}
  }
}
