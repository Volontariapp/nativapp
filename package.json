{
  "name": "@monorepo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "spendApp React Native mobile application (Expo SDK 54)",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "prestart": "yarn setup:env",
    "dev": "expo start",
    "start": "expo start",
    "start:local": "APP_ENV=local NODE_ENV=development expo start",
    "start:dev": "APP_ENV=development NODE_ENV=development expo start",
    "start:test": "APP_ENV=test NODE_ENV=test expo start",
    "start:prod": "APP_ENV=production NODE_ENV=production expo start --no-dev",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src/",
    "ts:check": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build": "expo export",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "doctor": "react-doctor"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
