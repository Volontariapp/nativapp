{
  "name": "@monorepo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "spendApp React Native mobile application (Expo SDK 54)",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "prestart": "yarn setup:env",
    "dev": "expo start",
    "start": "expo start",
    "start:local": "APP_ENV=local NODE_ENV=development expo start",
    "start:dev": "APP_ENV=development NODE_ENV=development expo start",
    "start:test": "APP_ENV=test NODE_ENV=test expo start",
    "start:prod": "APP_ENV=production NODE_ENV=production expo start --no-dev",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src/",
    "ts:check": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build": "expo export",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "doctor": "react-doctor"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native-stack": "^7.3.16",
    "@react-navigation/native-tabs": "npm:@react-navigation/bottom-tabs@^7.4.0",
    "@tanstack/react-query": "^5.100.14",
    "@volontariapp/config": "3.2.0",
    "@volontariapp/contracts": "4.2.3",
    "@volontariapp/errors": "0.6.0",
    "@volontariapp/logger": "0.2.5",
    "@volontariapp/messaging": "^2.7.6",
    "@volontariapp/shared": "0.6.4",
    "axios": "^1.16.1",
    "class-validator": "^0.15.1",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.76.1",
    "react-native": "0.81.5",
    "react-native-bottom-tabs": "^1.2.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^9.18.0",
    "@types/react": "~19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@volontariapp/config": "3.2.0",
    "@volontariapp/contracts": "4.2.3",
    "@volontariapp/logger": "0.2.5",
    "@volontariapp/shared": "0.6.4",
    "eslint": "~9.18.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "react-doctor": "^0.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.19.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
